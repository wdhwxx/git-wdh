# ============================================================
# 环境变量模板（Environment Variables Template）
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env（去掉.example后缀）
#   2. 填写真实配置（.env已被.gitignore忽略，不会提交到仓库）
#   3. 所有敏感信息（密钥、账号、密码）必须放在这里，禁止写在代码或yaml中
#
# 设计原则：
#   - 为实盘券商对接、实时行情、消息推送做好完整预留
#   - 模板中只放占位符，绝对不能写真实密钥
#   - 代码层通过 myquant.core.settings 加载，支持环境变量覆盖yaml配置
# ============================================================

# ===== 数据源配置 =====
# AkShare（免费，无需token）
AKSHARE_ENABLED=true
# Tushare（付费/积分，可选）
TUSHARE_TOKEN=your_tushare_token_here
# 实时行情源（为分钟级/Tick级实盘预留）
REALTIME_DATA_SOURCE=akshare          # akshare / xtp / qmt / custom
REALTIME_DATA_FREQUENCY=daily         # tick / 1m / 5m / 15m / 30m / 60m / daily

# ===== 数据目录 =====
DATA_DIR=./datasets/processed
RAW_DATA_DIR=./datasets/raw
FEATURE_DIR=./datasets/features

# ===== 数据库配置 =====
DB_TYPE=sqlite
DB_PATH=./database/quant.db
# MySQL/PostgreSQL（可选，取消注释并填写）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=quant_db

# ===== 交易配置 =====
TRADE_MODE=paper                      # paper=模拟盘 / live=实盘
INITIAL_CAPITAL=1000000

# ===== 实盘券商配置（为多券商对接预留）=====
# 券商类型：simulated / xtp / qmt / custom
BROKER_TYPE=simulated
BROKER_ADAPTER=simnow_broker          # 券商适配器名称（对应myquant/live/brokers/）

# 券商交易服务器（实盘时填写）
BROKER_HOST=your_broker_host
BROKER_PORT=your_broker_port
# 券商账号密码（从环境变量读取，禁止写在yaml或代码中）
BROKER_ACCOUNT=your_broker_account
BROKER_PASSWORD=your_broker_password
# 券商认证（部分券商需要）
BROKER_CLIENT_ID=your_client_id
BROKER_CLIENT_SECRET=your_client_secret

# 行情服务器（部分券商交易与行情分离）
MARKET_DATA_HOST=your_market_data_host
MARKET_DATA_PORT=your_market_data_port

# ===== 实盘状态持久化（崩溃恢复必备）=====
STATE_DIR=./实盘状态
SIGNAL_DIR=./实盘信号
AUTO_RECOVER_ON_START=true            # 启动时自动恢复上次持仓状态

# ===== 消息推送（不配置则仅写本地日志）=====
# 飞书Webhook
FEISHU_WEBHOOK=your_feishu_webhook_url_here
FEISHU_SECRET=your_feishu_secret_here
# 企业微信Webhook
WECOM_WEBHOOK=your_wecom_webhook_url_here
# 邮件SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_email_auth_code
SMTP_TO=recipient@example.com

# ===== Docker 部署安全配置（docker/docker-compose.yml 使用，H5 加固）=====
# PostgreSQL 强口令（docker compose --profile postgres up 时必须设置）
POSTGRES_PASSWORD=change_me_to_strong_password
# Redis 强口令（docker compose --profile redis up 时必须设置）
REDIS_PASSWORD=change_me_to_strong_redis_password
# 端口绑定（默认仅本机 127.0.0.1；如需对外服务改为 0.0.0.0）
API_BIND=127.0.0.1
DASHBOARD_BIND=127.0.0.1
# 看板鉴权（疑点4确认：反向代理 Basic Auth）——必须修改为强口令后再对外暴露
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-strong

DB_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

# ===== 日志级别 =====
LOG_LEVEL=INFO
LOG_DIR=./logs

# ===== 回测输出 =====
BACKTEST_OUTPUT_DIR=./outputs

# ===== 防未来函数校验（强制开启，不可关闭）=====
LOOKAHEAD_GUARD_ENABLED=true
LOOKAHEAD_GUARD_STRICT=true           # 严格模式：发现未来函数直接报错终止
