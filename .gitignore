# ===== Python =====
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.egg-info/
dist/
build/
*.egg
*.whl
*.manifest
*.spec

# ===== 虚拟环境 =====
.venv/
venv/
env/
ENV/

# ===== IDE =====
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ===== 环境变量（绝对不能提交密钥）=====
.env
.env.*
!.env.example

# ===== 数据与日志 =====
data/
# datasets目录：保留骨架，忽略内部数据文件
datasets/**/*
!datasets/**/.gitkeep

# 日志目录：保留骨架，忽略内部日志文件
logs/**/*
!logs/.gitkeep

*.db
*.sqlite
*.sqlite3

# ===== 量化数据产出 =====
# outputs目录：保留骨架，忽略回测结果
outputs/**/*
!outputs/.gitkeep

# ===== 缓存目录（V5回测性能优化新增，保留骨架，忽略缓存产物）=====
# cache/ 运行时缓存：因子L2磁盘缓存、数据指纹仓库、回测结果缓存、临时文件
cache/**/*
!cache/**/.gitkeep

# ===== 实盘状态与信号（实盘对接必备，不入库）=====
# 实盘运行时产生的持仓、资金、交易记录、信号报告，全部忽略
实盘状态/**/*
!实盘状态/.gitkeep
实盘信号/**/*
!实盘信号/.gitkeep

# 旧项目遗留目录（本项目不再使用，保留做兼容）
# backtest_output/

# ===== 回测批量结果缓存（#34: git init 时发现 results/ 32项混入暂存，启用忽略）=====
# results/ 为批量回测指纹+结果+汇总报告运行时缓存，不入库
results/**/*
!results/**/.gitkeep

*.parquet
*.feather
*.h5
*.hdf5

# ===== 模型产物 =====
/models/
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.joblib

# ===== Jupyter =====
.ipynb_checkpoints/
*.ipynb_checkpoints

# ===== 缓存与临时文件 =====
.cache/
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.tmp
*.bak
*.log

# L4修复: 审计修复备份目录（.bak_20260911.py 等不匹配 *.bak，需整目录忽略）
backups/

# ===== 基准测试与覆盖率产物（P3-3 性能基准新增）=====
# pytest-benchmark 输出目录（基准测试结果 JSON/图表）
.benchmarks/

# ===== 数据库运行时文件 =====
*.db-journal
*.sqlite-journal
*-journal
# P2-D4-001 整改：SQLite WAL/SHM 伴生文件（quant.db-wal/-shm 为运行时数据，防 git add -A 误提交）
*.db-wal
*.db-shm

# ===== 系统文件 =====
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== 实际配置文件（不入库，只保留.example模板）=====
config/*.yaml
!config/*.example.yaml
# ✨【BASE-3 #198】settings.yaml 例外入库：monitoring 阈值真源（R-04 slo 锁定表，
#   无敏感信息；notification 仍在 live_config.yaml 不入库），阈值修改可追溯、版本化
!config/settings.yaml
# ✨【门禁施工 M0-03 #271】strategy_registry.yaml 例外入库：策略注册表 + ruleset 映射真源
#   （防泄漏门禁 L-1 契约层，被 exit 强制/contract.py/CI 门禁矩阵消费；无敏感信息），版本化可追溯
!config/strategy_registry.yaml
# ✨【门禁施工 M0P-02 #279】data_time_semantics.yaml 例外入库：列级时点台账真源
#   （防泄漏门禁 0-P，被 consumption.py/contract.py/CI 台账校验消费；无敏感信息），版本化可追溯
!config/data_time_semantics.yaml
# L6修复: 运行时状态文件（data_clean_run.json 等），防误提交
config/*.json

